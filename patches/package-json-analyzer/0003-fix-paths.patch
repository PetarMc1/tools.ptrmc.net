@@ -14,8 +14,28 @@ const statusLabel: Record<HealthStatus, string> = {
   unreachable: 'Backend: offline',
 };
 
+const VITE_BASE = (import.meta as any)?.env?.BASE_URL ?? "/";
+const basePrefix = VITE_BASE.endsWith("/") ? VITE_BASE.slice(0, -1) : VITE_BASE;
+
+
+function prefixed(href: string): string {
+  if (!href.startsWith("/")) {
+    href = "/" + href;
+  }
+  return `${basePrefix}${href}`;
+}
+
+function buildPathFor(route: Route): string {
+  if (route === "about") {
+    return `${basePrefix}/about`;
+  }
+  return prefixed("/");
+}
+
